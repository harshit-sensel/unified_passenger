<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/line"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_login_card"
    android:elevation="2dp"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Rule Title & Status Tag -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/txt"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#0F172A"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_phone_input"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:text="Mandatory"
            android:textColor="#EF4444"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="12dp"
        android:background="#E2E8F0" />

    <!-- Radio Controls or Input -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <RadioGroup
            android:id="@+id/radioType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/pass"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:buttonTint="#10B981"
                android:text="Yes"
                android:textColor="#1E293B"
                android:textSize="14sp" />

            <RadioButton
                android:id="@+id/fail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="#EF4444"
                android:text="No"
                android:textColor="#1E293B"
                android:textSize="14sp" />
        </RadioGroup>

        <EditText
            android:id="@+id/edittxt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_phone_input"
            android:digits="abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789 "
            android:inputType="textNoSuggestions"
            android:maxLength="150"
            android:maxLines="3"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:textColor="#0F172A"
            android:textSize="14sp"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/image_camera"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginStart="12dp"
            android:contentDescription="Camera icon"
            android:onClick="onClick"
            android:scaleType="centerCrop"
            android:src="@drawable/file_add"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>