<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              android:orientation="vertical"
              android:layout_width="match_parent"
              android:layout_height="match_parent"
              android:background="@color/gray"
              android:gravity="center_horizontal"
              android:padding="@dimen/activity_vertical_margin">
    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/sensel"/>
    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/logo"
        android:layout_marginTop="-30dp"/>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Enter Mobile Number"
        android:textStyle="bold"
        android:textSize="@dimen/activity_vertical_margin"
        android:padding="@dimen/activity_vertical_margin"
        android:textColor="@color/black"
        android:id="@+id/header"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="10dp">

    <EditText
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:digits="0123456789"
        android:inputType="phone"
        android:padding="@dimen/activity_vertical_margin"
        android:textColor="@color/black"
        android:id="@+id/input_phNo"
        android:maxLength="10"
        android:background="@color/white"/>
    </LinearLayout>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Invalid Mobile Number"
        android:padding="@dimen/activity_vertical_margin"
        android:textColor="@color/red"
        android:visibility="gone"
        android:id="@+id/Login_Attempts_txt"/>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Enter 10 digit mobile number registered with this app."
        android:padding="@dimen/activity_vertical_margin"
        android:textColor="#5A5A5A"
        android:id="@+id/info"/>
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_login"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:padding="12dp"
        android:textSize="18dp"
        android:textColor="#ffffff"
        android:background="#508fff"
        android:text="Login"/>

</LinearLayout>