<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_login_card"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Top Icon & Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="14dp"
            android:background="@drawable/bg_icon_container"
            android:backgroundTint="#E0F2FE"
            android:padding="8dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:src="@drawable/ic_tag_in_otp" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tag-In OTP Code"
                android:textColor="#0F172A"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/dialog_otp_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Please share this OTP with your driver to Tag-In"
                android:textColor="#2563EB"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- 4-Box OTP Display Grid Row (Read-Only Styled TextViews) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="18dp"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/dialog_otp_1"
            android:layout_width="54dp"
            android:layout_height="58dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_otp_digit_box"
            android:gravity="center"
            android:text="-"
            android:textColor="#0F172A"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/dialog_otp_2"
            android:layout_width="54dp"
            android:layout_height="58dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_otp_digit_box"
            android:gravity="center"
            android:text="-"
            android:textColor="#0F172A"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/dialog_otp_3"
            android:layout_width="54dp"
            android:layout_height="58dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_otp_digit_box"
            android:gravity="center"
            android:text="-"
            android:textColor="#0F172A"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/dialog_otp_4"
            android:layout_width="54dp"
            android:layout_height="58dp"
            android:background="@drawable/bg_otp_digit_box"
            android:gravity="center"
            android:text="-"
            android:textColor="#0F172A"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Option 1: Subtle Rounded Pill Button -->
    <LinearLayout
        android:id="@+id/dialog_btn_resend"
        android:layout_width="wrap_content"
        android:layout_height="38dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_resend_pill"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingEnd="18dp">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginEnd="8dp"
            android:contentDescription="@null"
            android:src="@drawable/refresh"
            android:tint="#334155" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Resend OTP Code"
            android:textColor="#334155"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Back to Home Button -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/dialog_btn_back"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/bg_login_button"
        android:elevation="2dp"
        android:text="BACK TO HOME"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>
