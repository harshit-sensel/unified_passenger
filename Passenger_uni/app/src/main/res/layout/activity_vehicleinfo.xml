<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              android:orientation="vertical"
              android:layout_width="match_parent"
              android:layout_height="match_parent">
    <TextView
        android:layout_marginTop="20dp"
        android:paddingLeft="20dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Select Vehicle"
        android:textSize="18dp"
        android:textColor="@color/colorPrimaryDark"/>


    <AutoCompleteTextView
        android:id="@+id/autoVehText"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:textSize="18dp"
        android:hint="Type vehicleid"
        android:digits="abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
        android:singleLine="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLength="25"/>
    <TextView
        android:layout_marginTop="20dp"
        android:paddingLeft="20dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Enter Vehicle"
        android:textSize="18dp"
        android:id="@+id/txt"
        android:visibility="gone"
        android:textColor="@color/colorPrimaryDark"/>
    <EditText
        android:textSize="18dp"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Enter VehicleId"
        android:maxLength="15"
        android:digits="abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
        android:id="@+id/edittxt"
        android:visibility="gone"/>
    <RadioGroup
        android:id="@+id/radioType"
        android:paddingLeft="20dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="20dp">

        <RadioButton
            android:id="@+id/rbAssigned"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Assigned Driver"
            android:checked="true"/>

        <RadioButton
            android:id="@+id/rbChange"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Driver Change"/>

    </RadioGroup>
    <TextView
        android:layout_marginTop="20dp"
        android:paddingLeft="20dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/type"
        android:text="Assigned Driver"
        android:textSize="18dp"
        android:textColor="@color/colorPrimaryDark"/>


    <AutoCompleteTextView
        android:id="@+id/autoText"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:textSize="18dp"
        android:hint="Type driver name"
        android:singleLine="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:enabled="false"/>

    <TextView
        android:layout_marginTop="20dp"
        android:paddingLeft="20dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Enter Driver Details"
        android:textSize="18dp"
        android:id="@+id/dritxt"
        android:visibility="gone"
        android:textColor="@color/colorPrimaryDark"/>
    <EditText
        android:textSize="18dp"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Enter Driver Details"
        android:maxLength="30"
        android:digits="abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ 0123456789"
        android:id="@+id/driedittxt"
        android:visibility="gone"/>

    <!--<TextView
        android:layout_marginTop="20dp"
        android:paddingLeft="20dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Driver Image"
        android:textSize="18dp"
        android:textColor="@color/colorPrimaryDark"/>
    <ImageView
        android:paddingLeft="20dp"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:id="@+id/driver_image"
        android:onClick="onClick"
        android:src="@drawable/file_add" />-->
    <TextView
        android:layout_marginTop="20dp"
        android:paddingLeft="20dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/zonetxt"
        android:text="Select Zone"
        android:textSize="18dp"
        android:visibility="gone"
        android:textColor="@color/colorPrimaryDark"/>


    <AutoCompleteTextView
        android:id="@+id/zoneautoTxt"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:textSize="18dp"
        android:hint="Type Zone"
        android:singleLine="true"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:layout_marginTop="20dp"
        android:paddingLeft="20dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/twrtxt"
        android:text="Select Tower ID"
        android:textSize="18dp"
        android:visibility="gone"
        android:textColor="@color/colorPrimaryDark"/>


    <AutoCompleteTextView
        android:id="@+id/twrautoTxt"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:textSize="18dp"
        android:hint="Type Tower ID"
        android:singleLine="true"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="20dp"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:padding="12dp"
        android:textSize="18dp"
        android:textColor="#ffffff"
        android:background="#508fff"
        android:text="Continue"/>

</LinearLayout>
    </ScrollView>