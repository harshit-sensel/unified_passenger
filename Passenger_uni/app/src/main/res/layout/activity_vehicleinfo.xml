<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC">

    <!-- Top Royal Blue Header with Refresh & Logout Icons -->
    <RelativeLayout
        android:id="@+id/header_container"
        android:layout_width="match_parent"
        android:layout_height="130dp"
        android:background="@drawable/bg_header_blue"
        android:paddingHorizontal="20dp"
        android:paddingTop="24dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Passenger App"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Select Vehicle &amp; Driver"
                android:textColor="#93C5FD"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Right Side Header Icons (Refresh & Logout) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btn_refresh"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Refresh"
                android:padding="6dp"
                android:src="@drawable/refresh" />

            <ImageView
                android:id="@+id/btn_logout"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Logout"
                android:padding="6dp"
                android:src="@drawable/ic_logout_modern" />
        </LinearLayout>
    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/header_container"
        android:layout_marginTop="-20dp"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_login_card"
                android:elevation="4dp"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Vehicle Selection Label -->
                <TextView
                    android:id="@+id/lbl_select_veh"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="SELECT VEHICLE"
                    android:textColor="#475569"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <!-- AutoComplete Vehicle ID Box -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_phone_input"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="10dp">

                    <AutoCompleteTextView
                        android:id="@+id/autoVehText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@null"
                        android:digits="abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
                        android:hint="Type vehicleid"
                        android:singleLine="true"
                        android:textColor="#0F172A"
                        android:textColorHint="#94A3B8"
                        android:textSize="15sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/txt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="ENTER VEHICLE"
                    android:textColor="#475569"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <EditText
                    android:id="@+id/edittxt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_phone_input"
                    android:digits="abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
                    android:hint="Enter vehicleId"
                    android:maxLength="15"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="10dp"
                    android:textColor="#0F172A"
                    android:textSize="15sp"
                    android:visibility="gone" />

                <!-- RadioGroup Assignment Toggles -->
                <RadioGroup
                    android:id="@+id/radioType"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/rbAssigned"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:buttonTint="#2563EB"
                        android:checked="true"
                        android:text="Assigned Driver"
                        android:textColor="#1E293B"
                        android:textSize="14sp" />

                    <RadioButton
                        android:id="@+id/rbChange"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:buttonTint="#2563EB"
                        android:text="Driver Change"
                        android:textColor="#1E293B"
                        android:textSize="14sp" />
                </RadioGroup>

                <!-- Dynamic Driver Label (Assigned Driver / Driver Change) -->
                <TextView
                    android:id="@+id/type"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="ASSIGNED DRIVER"
                    android:textColor="#475569"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_phone_input"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="10dp">

                    <AutoCompleteTextView
                        android:id="@+id/autoText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@null"
                        android:enabled="false"
                        android:hint="Type driver name"
                        android:singleLine="true"
                        android:textColor="#0F172A"
                        android:textColorHint="#94A3B8"
                        android:textSize="15sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/dritxt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="DRIVER DETAILS"
                    android:textColor="#475569"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <EditText
                    android:id="@+id/driedittxt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_phone_input"
                    android:digits="abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ 0123456789"
                    android:hint="Enter driver details"
                    android:maxLength="30"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="10dp"
                    android:textColor="#0F172A"
                    android:textSize="15sp"
                    android:visibility="gone" />

                <!-- Optional Zone & Tower ID -->
                <TextView
                    android:id="@+id/zonetxt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="SELECT ZONE"
                    android:textColor="#475569"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <AutoCompleteTextView
                    android:id="@+id/zoneautoTxt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_phone_input"
                    android:hint="Type zone"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="10dp"
                    android:singleLine="true"
                    android:textColor="#0F172A"
                    android:textSize="15sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/twrtxt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="SELECT TOWER ID"
                    android:textColor="#475569"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <AutoCompleteTextView
                    android:id="@+id/twrautoTxt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_phone_input"
                    android:hint="Type tower ID"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="10dp"
                    android:singleLine="true"
                    android:textColor="#0F172A"
                    android:textSize="15sp"
                    android:visibility="gone" />

                <!-- Action Button -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_login_button"
                    android:elevation="2dp"
                    android:text="CONTINUE  ➔"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</RelativeLayout>